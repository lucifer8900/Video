{
  "ApiBaseline": {
    "ServiceName": "lingmai-redmist-api",
    "RateLimit": {
      "PermitLimit": 120,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Asr": {
    "Provider": "Mock",
    "MaxAudioBytes": 262144,
    "MaxDurationSeconds": 8,
    "AllowedSampleRatesHz": [ 16000 ],
    "RequiredChannels": 1,
    "RequiredBitsPerSample": 16,
    "DeleteAfterProcessing": true,
    "StagingDirectory": "",
    "MockTranscript": "测试转写",
    "OpenAi": {
      "Endpoint": "https://api.openai.com/v1/audio/transcriptions",
      "ApiKey": "",
      "ModelId": "gpt-4o-mini-transcribe",
      "TimeoutSeconds": 15
    }
  },
  "Intent": {
    "Provider": "Mock",
    "StoryBundlePath": "content/story/red-mist/story.bundle.json",
    "MaxTranscriptCharacters": 512,
    "MaxAcceptedTranscriptCharacters": 4096,
    "MockOutcome": "irrelevant",
    "MockIntentId": "",
    "MockConfidence": 0.0,
    "OpenAi": {
      "Endpoint": "https://api.openai.com/v1/responses",
      "ApiKey": "",
      "ModelId": "",
      "TimeoutSeconds": 8
    }
  },
  "Generation": {
    "Enabled": false
  },
  "Ledger": {
    "Enabled": false,
    "Provider": "InMemory",
    "ConnectionString": "",
    "MigrationsDirectory": ""
  }
}
