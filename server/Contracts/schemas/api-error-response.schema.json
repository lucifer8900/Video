{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/api-error-response.schema.json",
  "title": "ApiErrorResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "code",
    "message"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "code": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
