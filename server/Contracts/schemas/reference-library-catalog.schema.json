{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingmai.example/schemas/reference-library-catalog.schema.json",
  "title": "CX-506 reference library catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "libraryId",
    "referenceOnly",
    "shipInBuild",
    "minimumAssetsPerCategory",
    "allowedLicenses",
    "categories",
    "assets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "libraryId": { "const": "cx506-real-reference-library-v1" },
    "referenceOnly": { "const": true },
    "shipInBuild": { "const": false },
    "minimumAssetsPerCategory": { "type": "integer", "minimum": 4, "maximum": 4 },
    "allowedLicenses": {
      "type": "array",
      "prefixItems": [
        { "const": "cc0" },
        { "const": "pdm" },
        { "const": "by" }
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "categories": {
      "type": "array",
      "prefixItems": [
        { "const": "landscape" },
        { "const": "architecture" },
        { "const": "plants" },
        { "const": "animals" },
        { "const": "waters" },
        { "const": "weather" },
        { "const": "astronomy" },
        { "const": "people" },
        { "const": "costumes_textiles" },
        { "const": "artifacts" },
        { "const": "geology_caves" },
        { "const": "light_fog_fire" }
      ],
      "items": false,
      "minItems": 12,
      "maxItems": 12,
      "uniqueItems": true
    },
    "assets": {
      "type": "array",
      "minItems": 48,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "httpsUri": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "title",
        "creator",
        "creatorUrl",
        "source",
        "sourcePageUrl",
        "downloadUrl",
        "license",
        "licenseVersion",
        "licenseUrl",
        "commercialUseAllowed",
        "modificationsAllowed",
        "shareAlikeRequired",
        "referenceOnly",
        "shipInBuild",
        "identityReuse",
        "referenceRoles",
        "localRelativePath",
        "mediaType",
        "byteLength",
        "width",
        "height",
        "sha256",
        "downloadedAtUtc"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^ref-[a-z0-9-]+-[0-9]{3}-[a-z0-9]{4,10}$" },
        "category": {
          "enum": [
            "landscape",
            "architecture",
            "plants",
            "animals",
            "waters",
            "weather",
            "astronomy",
            "people",
            "costumes_textiles",
            "artifacts",
            "geology_caves",
            "light_fog_fire"
          ]
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 512 },
        "creator": { "type": "string", "minLength": 1, "maxLength": 512 },
        "creatorUrl": {
          "oneOf": [
            { "$ref": "#/$defs/httpsUri" },
            { "type": "null" }
          ]
        },
        "source": { "type": "string", "minLength": 1, "maxLength": 128 },
        "sourcePageUrl": { "$ref": "#/$defs/httpsUri" },
        "downloadUrl": { "$ref": "#/$defs/httpsUri" },
        "license": { "enum": ["cc0", "pdm", "by"] },
        "licenseVersion": { "type": "string", "minLength": 1, "maxLength": 16 },
        "licenseUrl": { "$ref": "#/$defs/httpsUri" },
        "commercialUseAllowed": { "const": true },
        "modificationsAllowed": { "const": true },
        "shareAlikeRequired": { "const": false },
        "referenceOnly": { "const": true },
        "shipInBuild": { "const": false },
        "identityReuse": { "const": false },
        "referenceRoles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "composition",
              "structure",
              "material",
              "lighting",
              "weather",
              "color",
              "silhouette",
              "anatomy",
              "pose",
              "expression",
              "gaze",
              "gesture",
              "weight_balance",
              "garment_construction",
              "surface_detail"
            ]
          }
        },
        "localRelativePath": {
          "type": "string",
          "pattern": "^content/reference-library/raw/[a-z_]+/[a-z0-9._-]+\\.(jpg|png|webp)$"
        },
        "mediaType": { "enum": ["image/jpeg", "image/png", "image/webp"] },
        "byteLength": { "type": "integer", "minimum": 64, "maximum": 50000000 },
        "width": { "type": "integer", "minimum": 800, "maximum": 100000 },
        "height": { "type": "integer", "minimum": 600, "maximum": 100000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "downloadedAtUtc": { "type": "string", "format": "date-time" }
      }
    }
  }
}
