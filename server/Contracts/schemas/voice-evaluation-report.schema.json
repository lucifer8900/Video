{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/voice-evaluation-report.schema.json",
  "title": "VoiceEvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evaluationScope",
    "productionReadiness",
    "datasetId",
    "datasetSha256",
    "classifierId",
    "sampleCount",
    "audioSampleCount",
    "thresholds",
    "metrics",
    "passed",
    "classes",
    "samples"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "evaluationScope": {
      "type": "string",
      "minLength": 1
    },
    "productionReadiness": {
      "type": "string",
      "minLength": 1
    },
    "datasetId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "datasetSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "classifierId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1
    },
    "audioSampleCount": {
      "type": "integer",
      "minimum": 0
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumValidIntentAccuracy",
        "maximumSevereFalsePositiveRateExclusive"
      ],
      "properties": {
        "minimumValidIntentAccuracy": {
          "type": "number",
          "minimum": 0.9,
          "maximum": 1
        },
        "maximumSevereFalsePositiveRateExclusive": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 0.01
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "overallCorrect",
        "totalSamples",
        "overallAccuracy",
        "validIntentCorrect",
        "validIntentTotal",
        "validIntentAccuracy",
        "severeFalsePositiveCount",
        "nonSevereSampleTotal",
        "severeFalsePositiveRate"
      ],
      "properties": {
        "overallCorrect": {
          "type": "integer",
          "minimum": 0
        },
        "totalSamples": {
          "type": "integer",
          "minimum": 1
        },
        "overallAccuracy": {
          "$ref": "#/$defs/unitInterval"
        },
        "validIntentCorrect": {
          "type": "integer",
          "minimum": 0
        },
        "validIntentTotal": {
          "type": "integer",
          "minimum": 0
        },
        "validIntentAccuracy": {
          "$ref": "#/$defs/unitInterval"
        },
        "severeFalsePositiveCount": {
          "type": "integer",
          "minimum": 0
        },
        "nonSevereSampleTotal": {
          "type": "integer",
          "minimum": 0
        },
        "severeFalsePositiveRate": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "passed": {
      "type": "boolean"
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/classResult"
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/sampleResult"
      }
    }
  },
  "$defs": {
    "unitInterval": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "outcome": {
      "type": "string",
      "enum": [
        "matched",
        "abuse",
        "irrelevant",
        "too_long",
        "silence",
        "low_confidence"
      ]
    },
    "nullableId": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "classResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expectedOutcome",
        "total",
        "correct",
        "accuracy"
      ],
      "properties": {
        "expectedOutcome": {
          "$ref": "#/$defs/outcome"
        },
        "total": {
          "type": "integer",
          "minimum": 1
        },
        "correct": {
          "type": "integer",
          "minimum": 0
        },
        "accuracy": {
          "$ref": "#/$defs/unitInterval"
        }
      }
    },
    "sampleResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "nodeId",
        "expectedOutcome",
        "expectedIntentId",
        "actualOutcome",
        "actualIntentId",
        "confidence",
        "source",
        "correct",
        "severeFalsePositive"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "nodeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expectedOutcome": {
          "$ref": "#/$defs/outcome"
        },
        "expectedIntentId": {
          "$ref": "#/$defs/nullableId"
        },
        "actualOutcome": {
          "$ref": "#/$defs/outcome"
        },
        "actualIntentId": {
          "$ref": "#/$defs/nullableId"
        },
        "confidence": {
          "$ref": "#/$defs/unitInterval"
        },
        "source": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "correct": {
          "type": "boolean"
        },
        "severeFalsePositive": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "expectedOutcome": {
                "const": "matched"
              }
            },
            "required": [
              "expectedOutcome"
            ]
          },
          "then": {
            "properties": {
              "expectedIntentId": {
                "$ref": "common.schema.json#/$defs/id"
              }
            }
          },
          "else": {
            "properties": {
              "expectedIntentId": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "actualOutcome": {
                "const": "matched"
              }
            },
            "required": [
              "actualOutcome"
            ]
          },
          "then": {
            "properties": {
              "actualIntentId": {
                "$ref": "common.schema.json#/$defs/id"
              }
            }
          },
          "else": {
            "properties": {
              "actualIntentId": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
