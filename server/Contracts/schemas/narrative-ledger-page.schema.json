{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/narrative-ledger-page.schema.json",
  "title": "NarrativeLedgerPage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries", "nextCursor"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "entries": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["event", "receivedAtUtc"],
        "properties": {
          "event": {
            "$ref": "ledger-event.schema.json"
          },
          "receivedAtUtc": {
            "$ref": "common.schema.json#/$defs/dateTime"
          }
        }
      }
    },
    "nextCursor": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  }
}
