{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/association-template.schema.json",
  "title": "AssociationTemplate",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "templateReference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(?:\\{[A-Za-z][A-Za-z0-9_]*\\}[A-Za-z0-9._:-]*)*$"
    },
    "ledgerRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "minSeverity",
        "maxAgeWorldClock"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "debt_incurred",
            "debt_repaid",
            "secret_exposed",
            "promise_made",
            "promise_broken",
            "npc_rescued",
            "npc_abandoned",
            "enemy_spared",
            "item_gained",
            "quest_expired",
            "trump_card_revealed"
          ]
        },
        "minSeverity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "maxAgeWorldClock": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requiresLedger",
        "forbidsFacts",
        "chapterWindow"
      ],
      "properties": {
        "requiresLedger": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/ledgerRequirement"
          }
        },
        "forbidsFacts": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/templateReference"
          },
          "uniqueItems": true
        },
        "chapterWindow": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "parameterSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^(ledger\\.actors\\[[0-7]\\]|route\\.upcomingNode\\.location)$"
        }
      }
    },
    "effectRange": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        }
      ],
      "items": false
    },
    "allowedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "relationship",
            "clue",
            "branch_unlock"
          ]
        },
        "field": {
          "type": "string",
          "enum": [
            "trust",
            "respect",
            "fear",
            "debt",
            "suspicion",
            "affection"
          ]
        },
        "range": {
          "$ref": "#/$defs/effectRange"
        },
        "value": {
          "$ref": "#/$defs/templateReference"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "relationship"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "field",
              "range"
            ],
            "properties": {
              "value": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "clue",
                  "branch_unlock"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "field": false,
              "range": false
            }
          }
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "templateId",
    "kind",
    "authorityLevel",
    "preconditions",
    "parameterSlots",
    "injectionPoints",
    "textPolicy",
    "allowedEffects",
    "mediaPolicy",
    "fallbackThreadId",
    "cooldownWorldClock",
    "maxTriggersPerPlayer",
    "approvalStatus"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "templateId": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^assoc\\."
        }
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "callback",
        "foreshadow",
        "consequence",
        "encounter"
      ]
    },
    "authorityLevel": {
      "const": "L2"
    },
    "preconditions": {
      "$ref": "#/$defs/preconditions"
    },
    "parameterSlots": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/parameterSlot"
      }
    },
    "injectionPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "node_intro",
          "travel_event",
          "npc_mention"
        ]
      },
      "uniqueItems": true
    },
    "textPolicy": {
      "const": "llm_variant_within_style_guide"
    },
    "allowedEffects": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/allowedEffect"
      },
      "uniqueItems": true
    },
    "mediaPolicy": {
      "type": "string",
      "enum": [
        "reuse_only",
        "allow_runtime_generation"
      ]
    },
    "fallbackThreadId": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^assoc\\."
        }
      ]
    },
    "cooldownWorldClock": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "maxTriggersPerPlayer": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "approvalStatus": {
      "$ref": "common.schema.json#/$defs/status"
    }
  }
}
