{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/story-thread.schema.json",
  "title": "StoryThread",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "relationshipField": {
      "type": "string",
      "enum": [
        "trust",
        "respect",
        "fear",
        "debt",
        "suspicion",
        "affection"
      ]
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "relationship",
            "clue",
            "branch_unlock"
          ]
        },
        "targetRef": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "field": {
          "$ref": "#/$defs/relationshipField"
        },
        "delta": {
          "type": "number",
          "minimum": -10,
          "maximum": 10
        },
        "value": {
          "$ref": "common.schema.json#/$defs/id"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "relationship"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "targetRef",
              "field",
              "delta"
            ],
            "properties": {
              "value": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "clue",
                  "branch_unlock"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "targetRef": false,
              "field": false,
              "delta": false
            }
          }
        }
      ]
    },
    "injection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "point",
        "text",
        "effects"
      ],
      "properties": {
        "nodeId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "point": {
          "type": "string",
          "enum": [
            "node_intro",
            "travel_event",
            "npc_mention"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u200E\\u200F\\u2028-\\u202E\\u2066-\\u2069\\uFEFF]*$"
        },
        "effects": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/effect"
          }
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "threadId",
    "templateId",
    "playerId",
    "resolvedParams",
    "injections",
    "mediaRefs",
    "expiresAtChapterEnd",
    "auditRef",
    "fallbackUsed"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "threadId": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^thr\\."
        }
      ]
    },
    "templateId": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^assoc\\."
        }
      ]
    },
    "playerId": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^p\\."
        }
      ]
    },
    "resolvedParams": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "common.schema.json#/$defs/id"
      }
    },
    "injections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/injection"
      }
    },
    "mediaRefs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "common.schema.json#/$defs/mediaRef"
      },
      "uniqueItems": true
    },
    "expiresAtChapterEnd": {
      "const": true
    },
    "auditRef": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "pattern": "^genjob\\."
        }
      ]
    },
    "fallbackUsed": {
      "type": "boolean"
    }
  }
}
