{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lingmai.example/schemas/red-mist-visual-bible.schema.json",
  "title": "Red Mist CX-508 Visual Bible",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "cardId",
    "worldId",
    "referenceCatalog",
    "generationPolicy",
    "requiredIdentityAnchorIds",
    "requiredFirstFrameIds",
    "candidates"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "cardId": { "const": "CX-508" },
    "worldId": { "const": "lingmai-ember-red-mist" },
    "referenceCatalog": { "const": "content/reference-library/catalog.json" },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stillImagesOnly",
        "geminiOrVeoUsed",
        "overwriteExistingAssets",
        "realPeopleIdentityReuseAllowed",
        "adoptionRequiresHumanReview",
        "allowUnverifiedPersonalReferences"
      ],
      "properties": {
        "stillImagesOnly": { "const": true },
        "geminiOrVeoUsed": { "const": false },
        "overwriteExistingAssets": { "const": false },
        "realPeopleIdentityReuseAllowed": { "const": false },
        "adoptionRequiresHumanReview": { "const": true },
        "allowUnverifiedPersonalReferences": { "const": true }
      }
    },
    "requiredIdentityAnchorIds": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 7,
      "maxItems": 7,
      "items": { "$ref": "#/$defs/versionedId" }
    },
    "requiredFirstFrameIds": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 15,
      "maxItems": 15,
      "items": { "$ref": "#/$defs/versionedId" }
    },
    "candidates": {
      "type": "array",
      "minItems": 22,
      "maxItems": 22,
      "items": { "$ref": "#/$defs/candidate" }
    }
  },
  "$defs": {
    "versionedId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*\\.v[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "referenceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetId", "assetSha256", "role"],
      "properties": {
        "assetId": { "type": "string", "minLength": 1 },
        "assetSha256": { "$ref": "#/$defs/sha256" },
        "role": {
          "enum": [
            "structure",
            "material",
            "lighting",
            "weather",
            "pose",
            "expression",
            "garment_construction",
            "surface_detail",
            "anatomy"
          ]
        }
      }
    },
    "postProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "sourceWidth", "sourceHeight", "outputWidth", "outputHeight"],
      "properties": {
        "mode": { "enum": ["none", "aspect_crop"] },
        "sourceWidth": { "type": "integer", "minimum": 1 },
        "sourceHeight": { "type": "integer", "minimum": 1 },
        "outputWidth": { "type": "integer", "minimum": 1 },
        "outputHeight": { "type": "integer", "minimum": 1 },
        "cropStrategy": { "enum": ["center", "declared_focus"] },
        "focusDescription": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaType", "byteLength", "sha256", "width", "height"],
      "properties": {
        "mediaType": { "const": "image/png" },
        "byteLength": { "type": "integer", "minimum": 24 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "width": { "type": "integer", "minimum": 640 },
        "height": { "type": "integer", "minimum": 360 }
      }
    },
    "reviewChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skinAndFabric",
        "weightBearing",
        "contactShadows",
        "sharedLighting",
        "perspectiveScale",
        "handsAndProps",
        "noTextOrWatermark",
        "noLandmarkReplication",
        "noActorLikeness"
      ],
      "properties": {
        "skinAndFabric": { "$ref": "#/$defs/reviewStatus" },
        "weightBearing": { "$ref": "#/$defs/reviewStatus" },
        "contactShadows": { "$ref": "#/$defs/reviewStatus" },
        "sharedLighting": { "$ref": "#/$defs/reviewStatus" },
        "perspectiveScale": { "$ref": "#/$defs/reviewStatus" },
        "handsAndProps": { "$ref": "#/$defs/reviewStatus" },
        "noTextOrWatermark": { "$ref": "#/$defs/reviewStatus" },
        "noLandmarkReplication": { "$ref": "#/$defs/reviewStatus" },
        "noActorLikeness": { "$ref": "#/$defs/reviewStatus" }
      }
    },
    "reviewStatus": { "enum": ["pending", "pass", "fail"] },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "assetKind",
        "generationMode",
        "adoptionStatus",
        "adopted",
        "shipInBuild",
        "outputPath",
        "referenceInputs",
        "prompt",
        "avoidItems",
        "continuityLocks",
        "postProcess",
        "artifact",
        "reviewChecks"
      ],
      "properties": {
        "assetId": { "$ref": "#/$defs/versionedId" },
        "assetKind": { "enum": ["identity_anchor", "creature_anchor", "first_frame"] },
        "generationMode": { "const": "codex_builtin_imagegen" },
        "adoptionStatus": { "const": "needs_review" },
        "adopted": { "const": false },
        "shipInBuild": { "const": false },
        "outputPath": {
          "type": "string",
          "pattern": "^content/visual-candidates/cx508/(identity-anchors|first-frames)/[a-z0-9_]+_v[1-9][0-9]*\\.png$"
        },
        "referenceInputs": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/referenceInput" }
        },
        "prompt": { "type": "string", "minLength": 180 },
        "avoidItems": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "continuityLocks": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "items": { "type": "string", "minLength": 1 }
        },
        "postProcess": { "$ref": "#/$defs/postProcess" },
        "artifact": { "$ref": "#/$defs/artifact" },
        "reviewChecks": { "$ref": "#/$defs/reviewChecks" },
        "sourceFirstFramePath": {
          "type": "string",
          "pattern": "^unity/RedMistVerticalSlice/Assets/Resources/Generated/VideoFirstFrames/.+\\.png$"
        },
        "reuseVideoIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "assetKind": { "const": "first_frame" } },
            "required": ["assetKind"]
          },
          "then": { "required": ["sourceFirstFramePath", "reuseVideoIds"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["sourceFirstFramePath"] },
                { "required": ["reuseVideoIds"] }
              ]
            }
          }
        }
      ]
    }
  }
}
