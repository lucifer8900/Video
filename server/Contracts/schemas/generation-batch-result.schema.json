{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/generation-batch-result.schema.json",
  "title": "GenerationBatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestId",
    "batchId",
    "sourceManifestId",
    "sourceManifestContentHash",
    "targetTier",
    "sourcePreviewBatchRef",
    "status",
    "reasonCode",
    "currency",
    "items",
    "metrics",
    "contentHash"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "batchId": {
      "type": "string",
      "format": "uuid"
    },
    "sourceManifestId": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "sourceManifestContentHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "targetTier": {
      "type": "string",
      "enum": [
        "preview_fast",
        "final_quality"
      ]
    },
    "sourcePreviewBatchRef": {
      "oneOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "awaiting_review",
        "reviewed",
        "failed"
      ]
    },
    "reasonCode": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "metrics": {
      "$ref": "#/$defs/metrics"
    },
    "contentHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    }
  },
  "$defs": {
    "artifactPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mediaRef",
        "assetVersion",
        "contentHash",
        "mediaType"
      ],
      "properties": {
        "mediaRef": {
          "$ref": "common.schema.json#/$defs/mediaRef"
        },
        "assetVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "contentHash": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "mediaType": {
          "const": "video"
        }
      }
    },
    "nullableArtifactPin": {
      "oneOf": [
        {
          "$ref": "#/$defs/artifactPin"
        },
        {
          "type": "null"
        }
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shotId",
        "status",
        "generationJobRef",
        "attemptCount",
        "artifact",
        "actualDurationMilliseconds",
        "reviewStatus",
        "failureCode"
      ],
      "properties": {
        "shotId": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "awaiting_review",
            "adopted",
            "rejected",
            "failed"
          ]
        },
        "generationJobRef": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "artifact": {
          "$ref": "#/$defs/nullableArtifactPin"
        },
        "actualDurationMilliseconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewStatus": {
          "type": "string",
          "enum": [
            "pending",
            "adopted",
            "rejected"
          ]
        },
        "failureCode": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalItemCount",
        "attemptedItemCount",
        "attemptCount",
        "retryCount",
        "reviewedCount",
        "adoptedCount",
        "rejectedCount",
        "adoptionRate",
        "averageRetryCount",
        "actualCostMicros",
        "adoptedDurationMilliseconds",
        "unitCostPerFinishedSecondMicros",
        "costComplete"
      ],
      "properties": {
        "totalItemCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "attemptedItemCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "attemptCount": {
          "type": "integer",
          "minimum": 0
        },
        "retryCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "adoptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "rejectedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "adoptionRate": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "averageRetryCount": {
          "type": "number",
          "minimum": 0
        },
        "actualCostMicros": {
          "type": "integer",
          "minimum": 0
        },
        "adoptedDurationMilliseconds": {
          "type": "integer",
          "minimum": 0
        },
        "unitCostPerFinishedSecondMicros": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "costComplete": {
          "type": "boolean"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "targetTier": {
            "const": "preview_fast"
          }
        },
        "required": [
          "targetTier"
        ]
      },
      "then": {
        "properties": {
          "sourcePreviewBatchRef": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "targetTier": {
            "const": "final_quality"
          }
        },
        "required": [
          "targetTier"
        ]
      },
      "then": {
        "properties": {
          "sourcePreviewBatchRef": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}
