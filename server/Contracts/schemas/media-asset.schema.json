{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lingmaiyujin.example/v1/media-asset.schema.json",
  "title": "MediaAsset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "assetVersion",
    "mediaType",
    "contentHash",
    "uri",
    "language",
    "dependencyRefs"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "assetVersion": {
      "type": "string",
      "minLength": 1
    },
    "mediaType": {
      "type": "string",
      "enum": [
        "video",
        "audio",
        "image",
        "animation",
        "subtitle"
      ]
    },
    "contentHash": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "uri": {
      "type": "string",
      "format": "uri-reference"
    },
    "language": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 2
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "durationMilliseconds": {
      "type": "integer",
      "minimum": 0
    },
    "dependencyRefs": {
      "$ref": "common.schema.json#/$defs/idArray"
    },
    "generationJobRef": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "fallbackMediaRef": {
      "$ref": "common.schema.json#/$defs/mediaRef"
    },
    "approvalStatus": {
      "$ref": "common.schema.json#/$defs/status"
    }
  }
}
